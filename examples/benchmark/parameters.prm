subsection Laplace Problem<2>
  set Dirichlet boundary ids      = 0, 1, 2, 3
  set Number of refinement cycles = 10
  set Perform adaptive refinement = true
  set Use deal.II solver          = true
  set Verbosity level             = 10
  subsection AMG control
    set Aggregation filter             = FILTER
    set Aggregation threshold          = 1e-2
    set Aggregation type               = SOC1
    set Coarse matrix type             = DIST
    set Coarse solver                  = MUMPS #Type of solver used on the coarse level of the AMG
    set Cycle type                     = VCYCLE
    set Number of cycles               = 1
    set Parallel aggregation algorithm = COUPLED #DECOUPLED
    set Prolongator aggregation        = SMOOTHED
    set Smoother sweeps                = 1
    set Smoother type                  = FBGS
    set Verbose AMG info               = true
  end
  subsection Rhs function
    set Function constants  =
    set Function expression = 1.
    set Variable names      = x,y,t
  end
  subsection Solver parameters
    set Log frequency = 1
    set Log history   = true
    set Log result    = true
    set Max steps     = 1000
    set Reduction     = 1.e-6
    set Tolerance     = 1.e-10
  end
end
